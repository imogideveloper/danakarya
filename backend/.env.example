# Salin file ini ke .env (atau set langsung sebagai environment variable di server)
# saat deploy ke production. Untuk development lokal, semua sudah punya
# nilai default yang aman di settings.py sehingga file ini TIDAK wajib ada.

# Django
SECRET_KEY=ganti-dengan-secret-key-baru-yang-acak-dan-rahasia
DEBUG=False
ALLOWED_HOSTS=domain-backend-anda.com,www.domain-backend-anda.com

# Database (PostgreSQL)
DB_NAME=danakarya
DB_USER=danakarya
DB_PASSWORD=ganti-dengan-password-yang-kuat
DB_HOST=localhost
DB_PORT=5432

# CORS - domain frontend yang boleh akses API
CORS_ALLOWED_ORIGINS=https://domain-frontend-anda.com
